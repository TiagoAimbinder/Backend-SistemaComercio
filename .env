# Entorno: local | dev | prod
NODE_ENV=local
PORT=3000

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
# Opción 1 (Render): pegar la "External Database URL" de tu base
DATABASE_URL=postgresql://admin:AM3mrTmvLjBk0A2BhQtew5zxbLIU57uq@dpg-dbf2og5g1s2s73e926mg-a.virginia-postgres.render.com/pintoexpress
# Opción 2: datos por separado (se usan solo si DATABASE_URL está vacía)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=kiosco
# true para bases remotas (Render la exige); false para un Postgres local
DB_SSL=true

