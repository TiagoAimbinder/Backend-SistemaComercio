# Entorno: local | dev | prod
NODE_ENV=local
PORT=3000

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
# Opción 1 (Render): pegar la "External Database URL" de tu base
DATABASE_URL=
# Opción 2: datos por separado (se usan solo si DATABASE_URL está vacía)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=kiosco
# true para bases remotas (Render la exige); false para un Postgres local
DB_SSL=true

# Autenticación (JWT)
# Clave para firmar los tokens: mínimo 32 caracteres, distinta en cada entorno
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-64-caracteres
# Duración de la sesión (un turno)
JWT_EXPIRES_IN=12h
